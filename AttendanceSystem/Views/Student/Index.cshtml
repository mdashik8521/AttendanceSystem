@{
    ViewData["Title"] = "Student Dashboard";

    var student = ViewBag.Student;
    var attendancePercentage = ViewBag.AttendancePercentage ?? 0;
}

<div class="container student-dashboard">

    <!-- ================= HEADER ================= -->

    <div class="student-header">

        <div>
            <h1>
                Welcome, @student.User.FullName 👋
            </h1>

            <p>
                Track your attendance and academic information
                from one place.
            </p>
        </div>

        <div class="student-header-info">

            <span>
                Semester @student.Semester
            </span>

            <span>
                @student.Department.Name
            </span>

        </div>

    </div>


    <!-- ================= STUDENT INFO ================= -->

    <div class="student-info-card">

        <div class="student-info-title">
            👤 Student Information
        </div>

        <div class="row">

            <div class="col-md-4">
                <div class="student-info-item">
                    <span>Name</span>
                    <strong>
                        @student.User.FullName
                    </strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="student-info-item">
                    <span>Enrollment No.</span>
                    <strong>
                        @student.EnrollmentNo
                    </strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="student-info-item">
                    <span>Department</span>
                    <strong>
                        @student.Department.Name
                    </strong>
                </div>
            </div>

        </div>

    </div>


    <!-- ================= ATTENDANCE SUMMARY ================= -->

    <div class="section-heading">

        <div>
            <h3>Attendance Summary</h3>

            <p>
                Your overall attendance statistics
            </p>
        </div>

    </div>


    <div class="row g-4 mb-5">

        <!-- ATTENDANCE -->
        <div class="col-md-6 col-lg-3">

            <div class="student-stat-card">

                <div class="student-stat-icon student-blue">
                    📊
                </div>

                <span>Attendance</span>

                <h2>
                    @attendancePercentage%
                </h2>

                <small>
                    Overall percentage
                </small>

            </div>

        </div>


        <!-- PRESENT -->
        <div class="col-md-6 col-lg-3">

            <div class="student-stat-card">

                <div class="student-stat-icon student-green">
                    ✅
                </div>

                <span>Present</span>

                <h2>
                    @ViewBag.Present
                </h2>

                <small>
                    Classes attended
                </small>

            </div>

        </div>


        <!-- ABSENT -->
        <div class="col-md-6 col-lg-3">

            <div class="student-stat-card">

                <div class="student-stat-icon student-red">
                    ❌
                </div>

                <span>Absent</span>

                <h2>
                    @ViewBag.Absent
                </h2>

                <small>
                    Classes missed
                </small>

            </div>

        </div>


        <!-- LATE -->
        <div class="col-md-6 col-lg-3">

            <div class="student-stat-card">

                <div class="student-stat-icon student-yellow">
                    ⏰
                </div>

                <span>Late</span>

                <h2>
                    @ViewBag.Late
                </h2>

                <small>
                    Late attendance
                </small>

            </div>

        </div>

    </div>


    <!-- ================= ATTENDANCE PROGRESS ================= -->

    <div class="section-heading">

        <div>
            <h3>Attendance Progress</h3>

            <p>
                Your current attendance performance
            </p>
        </div>

    </div>


    <div class="attendance-progress-card">

        <div class="attendance-progress-top">

            <div>
                <span>Overall Attendance</span>

                <h2>
                    @attendancePercentage%
                </h2>
            </div>

            <div class="attendance-total">
                Total Classes:
                <strong>@ViewBag.TotalAttendance</strong>
            </div>

        </div>


        <div class="progress attendance-progress">

            <div class="progress-bar"
                 role="progressbar"
                 style="width: @attendancePercentage%;"
                 aria-valuenow="@attendancePercentage"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>


        <div class="attendance-progress-bottom">

            <span>
                ✅ Present: @ViewBag.Present
            </span>

            <span>
                ❌ Absent: @ViewBag.Absent
            </span>

            <span>
                ⏰ Late: @ViewBag.Late
            </span>

        </div>

    </div>


    <!-- ================= QUICK ACTION ================= -->

    <div class="quick-action-section">

        <a asp-controller="Student"
           asp-action="Attendance"
           class="student-action-button">

            📋 View Full Attendance →

        </a>

    </div>

</div>