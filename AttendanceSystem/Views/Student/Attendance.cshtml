@using AttendanceSystem.Models
@model List<AttendanceRecord>

@{
    ViewData["Title"] = "My Attendance";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Attendance</h1>
            <p class="text-muted">
                Complete attendance history
            </p>
        </div>

        <a asp-controller="Student"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No attendance records found yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Code</th>
                                <th>Start Time</th>
                                <th>Status</th>
                                <th>Marked At</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var record in Model)
                        {
                            <tr>

                                <td>
                                    @record.ClassSession?.Date.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <strong>
                                        @record.ClassSession?.Subject?.Name
                                    </strong>
                                </td>

                                <td>
                                    @record.ClassSession?.Subject?.Code
                                </td>

                                <td>
                                    @record.ClassSession?.StartTime
                                </td>

                                <td>

                                    @if (record.Status == AttendanceStatus.Present)
                                    {
                                        <span class="badge bg-success">
                                            Present
                                        </span>
                                    }
                                    else if (record.Status == AttendanceStatus.Absent)
                                    {
                                        <span class="badge bg-danger">
                                            Absent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Late
                                        </span>
                                    }

                                </td>

                                <td>
                                    @record.MarkedAt.ToString("dd MMM yyyy HH:mm")
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>