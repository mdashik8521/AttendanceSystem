@model AttendanceSystem.Models.ClassSession

@{
    ViewData["Title"] = "Attendance QR Code";
}

<div class="container mt-5">

    <div class="card shadow-sm mx-auto text-center"
         style="max-width: 600px;">

        <div class="card-body p-5">

            <h2 class="fw-bold mb-2">
                📱 Attendance QR Code
            </h2>

            <p class="text-muted mb-4">
                @Model.Subject?.Name
                (@Model.Subject?.Code)
            </p>

            <div class="mb-4">
                <div id="qrcode"
                     class="d-flex justify-content-center">
                </div>
            </div>

            <p class="text-muted">
                Students can scan this QR code to mark attendance.
            </p>

            <div class="alert alert-warning">
                ⏱️ QR code is valid for <strong>5 minutes</strong>.
            </div>

            <div class="mt-3">
                <strong>Session Date:</strong>
                @Model.Date.ToString("dd MMM yyyy")
            </div>

        </div>

    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
    const token = "@Model.QrToken";

    const attendanceUrl =
        window.location.origin +
        "/Student/Scan?token=" + encodeURIComponent(token);

    new QRCode(document.getElementById("qrcode"), {
        text: attendanceUrl,
        width: 250,
        height: 250
    });
</script>