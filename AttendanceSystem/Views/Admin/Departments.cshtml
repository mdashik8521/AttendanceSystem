@using AttendanceSystem.Models
@model List<Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">All Departments</h2>
            <p class="text-muted mb-0">
                Manage and view department information
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>
    </div>

    <div class="row g-4">

        @foreach (var department in Model)
        {
            <div class="col-lg-6">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="fw-bold mb-1">
                                    @department.Name
                                </h4>

                                <small class="text-muted">
                                    Department ID: @department.Id
                                </small>
                            </div>

                            <span class="badge bg-primary">
                                Department
                            </span>
                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-6">
                                <div class="bg-light rounded p-3">
                                    <small class="text-muted">
                                        Students
                                    </small>

                                    <h3 class="fw-bold mb-0">
                                        @department.Students.Count
                                    </h3>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="bg-light rounded p-3">
                                    <small class="text-muted">
                                        Teachers
                                    </small>

                                    <h3 class="fw-bold mb-0">
                                        @department.Teachers.Count
                                    </h3>
                                </div>
                            </div>

                        </div>

                        <h6 class="fw-bold mb-3">
                            Students in this Department
                        </h6>

                        @if (department.Students.Any())
                        {
                            <div class="table-responsive">

                                <table class="table table-sm table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Name</th>
                                            <th>Enrollment</th>
                                            <th>Semester</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @{
                                            var number = 1;
                                        }

                                        @foreach (var student in department.Students
                                            .OrderBy(s => s.EnrollmentNo))
                                        {
                                            <tr>
                                                <td>@number</td>

                                                <td>
                                                    @student.User?.FullName
                                                </td>

                                                <td>
                                                    @student.EnrollmentNo
                                                </td>

                                                <td>
                                                    @student.Semester
                                                </td>
                                            </tr>

                                            number++;
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border">
                                No students assigned to this department.
                            </div>
                        }

                        <h6 class="fw-bold mt-4 mb-3">
                            Teachers
                        </h6>

                        @if (department.Teachers.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">

                                @foreach (var teacher in department.Teachers)
                                {
                                    <span class="badge bg-secondary p-2">
                                        @teacher.User?.FullName
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <span class="text-muted">
                                No teachers assigned.
                            </span>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>